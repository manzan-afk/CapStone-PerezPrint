rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================
    function signedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get("role", "customer")
        : "customer";
    }

    function userRole() {
      return roleOf(request.auth.uid);
    }

    function isAdminOrStaff() {
      return signedIn() &&
        userRole() in ["admin", "staff"];
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow read: if signedIn();

      // Sign-up (see createUserProfile): users can only create their own profile as a customer.
      allow create: if signedIn() &&
        (
          (
            request.auth.uid == userId &&
            request.resource.data.get("role", "customer") == "customer"
          ) ||
          userRole() == "admin"
        );

      // Users can edit their own profile but not their role; only admins change roles.
      allow update: if signedIn() &&
        (
          userRole() == "admin" ||
          (
            request.auth.uid == userId &&
            request.resource.data.get("role", "customer") ==
              resource.data.get("role", "customer")
          )
        );

      allow delete: if signedIn() &&
        (
          request.auth.uid == userId ||
          userRole() == "admin"
        );
    }

    // =========================
    // SERVICES
    // =========================
    match /services/{serviceId} {
      allow read: if signedIn();

      allow write: if signedIn() &&
        userRole() == "admin";
    }

    // =========================
    // ORDERS
    // Order status and payment status are independent. An order can only move to
    // Printing / Ready / Picked Up once its payment is verified, and the payment
    // status on an order can only change together with its payments document.
    // =========================
    function orderIsPaid(data) {
      return data.get("paymentStatus", "unpaid") in ["verified", "paid"];
    }

    // Mirrors the app (getOrderPaymentStatus): anything that isn't pending, verified,
    // paid or refunded counts as unpaid, including older orders with a missing/odd value.
    function orderAwaitsPayment(data) {
      return !(data.get("paymentStatus", "unpaid") in ["pending", "verified", "paid", "refunded"]);
    }

    function orderStatusAllowed() {
      let oldStatus = resource.data.get("status", "placed");
      let newStatus = request.resource.data.get("status", "placed");
      return !(newStatus in ["printing", "ready", "completed"]) ||
        newStatus == oldStatus ||
        orderIsPaid(request.resource.data) ||
        // Orders that were already past the gate before this rule existed.
        (oldStatus in ["printing", "ready"] && newStatus != "printing");
    }

    function orderPaymentChangeAllowed(orderId) {
      let paymentId = request.resource.data.get("paymentId", "");
      return (
        request.resource.data.get("paymentStatus", "unpaid") ==
          resource.data.get("paymentStatus", "unpaid") &&
        paymentId == resource.data.get("paymentId", "")
      ) || (
        paymentId is string &&
        paymentId != "" &&
        getAfter(/databases/$(database)/documents/payments/$(paymentId)).data.orderId == orderId &&
        getAfter(/databases/$(database)/documents/payments/$(paymentId)).data.paymentStatus ==
          request.resource.data.get("paymentStatus", "unpaid")
      );
    }

    match /orders/{orderId} {
      allow read: if signedIn() &&
        (
          resource.data.customerId == request.auth.uid ||
          isAdminOrStaff()
        );

      allow create: if signedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.get("status", "placed") == "placed" &&
        request.resource.data.get("paymentStatus", "unpaid") == "unpaid";

      allow update: if
        (
          isAdminOrStaff() &&
          orderStatusAllowed() &&
          orderPaymentChangeAllowed(orderId)
        ) ||
        // Customer cancels an unpaid order that staff haven't started.
        (
          signedIn() &&
          resource.data.customerId == request.auth.uid &&
          resource.data.get("status", "placed") == "placed" &&
          orderAwaitsPayment(resource.data) &&
          request.resource.data.status == "cancelled" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "statusUpdatedAt",
            "updatedAt",
            "cancelledAt",
            "isArchived",
            "archivedAt"
          ])
        ) ||
        // Customer submits a payment: the order's payment status becomes "pending"
        // in the same batch that creates the payments document.
        (
          signedIn() &&
          resource.data.customerId == request.auth.uid &&
          resource.data.get("status", "placed") != "cancelled" &&
          orderAwaitsPayment(resource.data) &&
          request.resource.data.paymentStatus == "pending" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "paymentStatus",
            "paymentId",
            "updatedAt"
          ]) &&
          getAfter(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.customerId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.orderId == orderId &&
          getAfter(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.paymentStatus == "pending"
        );
    }

    // =========================
    // SETTINGS (settings/payment: shop GCash details, see paymentService.js)
    // =========================
    match /settings/payment {
      allow read: if signedIn();

      allow write: if signedIn() &&
        userRole() == "admin";
    }

    // =========================
    // PAYMENTS (manual GCash submissions, see paymentService.js)
    // Older documents used `status`; paymentStatus takes over once a payment is reviewed.
    // =========================
    function currentPaymentStatus() {
      return resource.data.get("paymentStatus", resource.data.get("status", "pending"));
    }

    match /payments/{paymentId} {
      allow read: if signedIn() &&
        (
          resource.data.customerId == request.auth.uid ||
          isAdminOrStaff()
        );

      allow create: if signedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.paymentId == paymentId &&
        request.resource.data.paymentStatus == "pending" &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.referenceNumber is string &&
        request.resource.data.referenceNumber.size() > 0 &&
        request.resource.data.orderId is string &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paymentId == paymentId;

      // Staff/admin review: verify (amount must equal the full order total),
      // reject (with a reason) or refund. Only the matching review fields may change.
      allow update: if isAdminOrStaff() &&
        (
          (
            currentPaymentStatus() == "pending" &&
            request.resource.data.paymentStatus == "verified" &&
            request.resource.data.verifiedBy == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "paymentStatus",
              "verifiedBy",
              "verifiedAt"
            ]) &&
            resource.data.amount ==
              get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.totalPrice
          ) ||
          (
            currentPaymentStatus() == "pending" &&
            request.resource.data.paymentStatus == "rejected" &&
            request.resource.data.rejectedBy == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "paymentStatus",
              "rejectedBy",
              "rejectedAt",
              "rejectionReason"
            ]) &&
            request.resource.data.rejectionReason is string &&
            request.resource.data.rejectionReason.size() > 0 &&
            request.resource.data.rejectionReason.size() <= 200
          ) ||
          (
            currentPaymentStatus() == "verified" &&
            request.resource.data.paymentStatus == "refunded" &&
            request.resource.data.refundedBy == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "paymentStatus",
              "refundedBy",
              "refundedAt"
            ])
          )
        );
    }

    // =========================
    // MESSAGING
    // Each document is a single direct message, queried by
    // participants / conversationId / recipientId (see messagingService.jsx).
    // =========================
    match /messages/{messageId} {
      allow read: if signedIn() &&
        (
          request.auth.uid in resource.data.participants ||
          resource.data.recipientId == request.auth.uid ||
          isAdminOrStaff()
        );

      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.participants[0] !=
          request.resource.data.participants[1] &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.recipientId in request.resource.data.participants &&
        request.resource.data.recipientId != request.auth.uid &&
        (
          userRole() != "customer" ||
          roleOf(request.resource.data.recipientId) != "customer"
        );

      allow update: if isAdminOrStaff();

      allow delete: if signedIn() &&
        userRole() == "admin";
    }

    // =========================
    // NOTIFICATIONS
    // Each notification belongs to one recipient. Recipients control read
    // state and deletion; authenticated users may create notifications only
    // with themselves as the sender.
    // =========================
    match /notifications/{notificationId} {
      allow read: if signedIn() &&
        resource.data.recipientId == request.auth.uid;

      allow create: if signedIn() &&
        request.resource.data.recipientId is string &&
        request.resource.data.recipientId.size() > 0 &&
        (
          request.resource.data.senderId == request.auth.uid ||
          request.resource.data.senderId == ""
        ) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.read == false &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId));

      allow update: if signedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "read",
          "readAt"
        ]) &&
        request.resource.data.read is bool;

      allow delete: if signedIn() &&
        resource.data.recipientId == request.auth.uid;
    }
  }
}